# Deployment tag and matching training checkpoint
OLLAMA_MODEL=qwen2.5:0.5b-instruct-q8_0
BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct
MODEL_ALIAS=local-llm

# Local ports and physical Ascend devices
OLLAMA_PORT=11434
LLAMA_CPP_PORT=18080
NPU_DEVICES=0
THREADS=8
LLAMA_SERVER_EXTRA_ARGS='--parallel 1 -lv 4'

# Reuse runtimes already installed on your server.
# LLAMA_SERVER_BIN=/path/to/llama-server
# PYTHON_BIN=/path/to/venv/bin/python
# CANN_ENV=/path/to/CANN/set_env.sh

# Use an existing Transformers cache on an offline server.
# HF_HUB_OFFLINE=1
